# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.hypothesis/
.eggs/
__pypackages__/
*.pyd
*.so

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*

# Notebooks
.ipynb_checkpoints/
*.nbconvert.ipynb

# Coverage and test output
.coverage
.coverage.*
htmlcov/
coverage.xml

# Packaging/build artifacts
dist/
build/
*.egg-info/

# Logs
logs/*
!logs/.gitkeep
*.log

# Large or raw experiment artifacts
*.mp4
*.avi
*.mov
*.h5
*.hdf5
*.pkl
*.pickle
*.npz
*.npy
*.mjb
*.zarr/
*.zip
*.tar
*.tar.gz
*.tgz

# Local generated result artifacts. Keep directory anchors.
results/**/*
!results/**/
!results/**/.gitkeep
!results/baseline/block_8_12_audit.json
!results/baseline/milestone_8b_materialization.json

# OS and editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
